NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Web Push (VAPID) - node scripts/generate-vapid-keys.mjs 로 생성
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# 묵상 질문 AI 생성과 하나님나라QT 사진 읽기(OCR)에 쓴다.
# 없으면 그 두 기능만 막히고 나머지는 그대로 동작한다.
ANTHROPIC_API_KEY=

# Vercel Cron 요청 인증용 (Vercel 프로젝트 환경변수에도 동일한 값을 등록)
CRON_SECRET=

# 공개 재생목록 읽기용 API 키 (Google Cloud - API 및 서비스 > 사용자 인증 정보 > API 키)
# 이 키만 있으면 추천찬양 동기화와 찬양콘티 재생목록 썸네일은 OAuth 없이 동작한다.
YOUTUBE_API_KEY=

# 관리자 유튜브 "좋아요 표시한 동영상"까지 쓰려면 필요 - Google Cloud OAuth Playground로 발급
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# (선택) 추천찬양 재생목록 지정 - 비워두면 관리자 계정의 "추천찬양" 재생목록을 이름으로 찾는다
YOUTUBE_RECOMMENDED_PLAYLIST_TITLE=
YOUTUBE_RECOMMENDED_PLAYLIST_ID=
